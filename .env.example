# Variables de entorno (NO subir .env real al repo)
# En produccion (Cloud Run) se inyectan con --set-env-vars, sin archivo.
FIREBASE_PROJECT_ID=tu-proyecto-gcp
ADMIN_EMAILS=tu-correo@dominio.com
# ALLOWED_ORIGIN=https://tu-dominio.web.app   # solo si el front va en otro origen
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json  # SOLO local

# --- Meta Conversions API (OPCIONAL, server-side) ---------------------------
# Mejora la optimización hacia leads de alta calidad (dual tracking pixel+CAPI).
# JSON por mercado: pixelId + token de system user con acceso a esos pixeles.
# META_CAPI={"cafe":{"pixelId":"1132300571584678","token":"EAA..."},"madera":{"pixelId":"1114909039466091","token":"EAA..."},"oro_compliance":{"pixelId":"1522257669353901","token":"EAA..."},"oro_tokenizado":{"pixelId":"2474685053036364","token":"EAA..."}}
# META_GRAPH_VERSION=v25.0   # versión vigente (feb-2026); súbela cuando Meta publique nuevas
# META_TEST_EVENT_CODE=TEST12345
# (GA4, WhatsApp y Calendly NO son secretos: se configuran en public/assets/site.js)
