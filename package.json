{
  "name": "socio-funnel",
  "version": "1.1.0",
  "private": true,
  "description": "Embudo de captacion de socios estrategicos (4 mercados, un motor) + panel admin.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "E2E_FULL_UI=1 playwright test",
    "cleanup:e2e": "node tests/cleanup.js",
    "optimize:images": "node scripts/optimize-images.js",
    "optimize:images:clean": "node scripts/optimize-images.js --delete-png",
    "test:unit": "node --test tests/unit/*.test.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.22.2",
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "sharp": "^0.35.1"
  }
}
